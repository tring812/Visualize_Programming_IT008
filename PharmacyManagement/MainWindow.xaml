<Window x:Class="PharmacyManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PharmacyManagement"
        xmlns:vm="clr-namespace:PharmacyManagement.ViewModels"
        xmlns:views="clr-namespace:PharmacyManagement.Views"
        mc:Ignorable="d"
        Title="Quản lý tiệm thuốc" Height="600" Width="900" MinWidth="650" MinHeight="470">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <!-- Gặp LoaiThuocViewModel ở đâu thì WPF vẽ bằng LoaiThuocView -->
        <DataTemplate DataType="{x:Type vm:LoaiThuocViewModel}">
            <views:LoaiThuocView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThuocViewModel}">
            <views:ThuocView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Margin="12,16,0,16">
            <Button Content="Loại thuốc" Command="{Binding OpenLoaiThuocCommand}" Padding="10,6"/>
            <Button Content="Thuốc" Command="{Binding OpenThuocCommand}" Padding="10,6" Margin="0,8,0,0"/>
        </StackPanel>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </DockPanel>
</Window>
