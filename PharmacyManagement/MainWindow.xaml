<Window x:Class="PharmacyManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PharmacyManagement"
        xmlns:vm="clr-namespace:PharmacyManagement.ViewModels"
        xmlns:views="clr-namespace:PharmacyManagement.Views"
        mc:Ignorable="d"
        Title="Quản lý tiệm thuốc" Height="600" Width="900">
    <Window.Resources>
        <!-- Gặp LoaiThuocViewModel ở đâu thì WPF vẽ bằng LoaiThuocView -->
        <DataTemplate DataType="{x:Type vm:LoaiThuocViewModel}">
            <views:LoaiThuocView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Tạm thời hiển thị thẳng màn Loại thuốc. T10 sẽ thay bằng menu trái
         + ContentControl Content="{Binding CurrentViewModel}" của MainViewModel. -->
    <ContentControl>
        <vm:LoaiThuocViewModel/>
    </ContentControl>
</Window>
