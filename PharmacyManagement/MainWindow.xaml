<Window x:Class="PharmacyManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PharmacyManagement"
        xmlns:vm="clr-namespace:PharmacyManagement.ViewModels"
        xmlns:views="clr-namespace:PharmacyManagement.Views"
        mc:Ignorable="d"
        Title="Quản lý tiệm thuốc" Height="600" Width="900">
    <Window.Resources>
        <!-- Gặp LoaiThuocViewModel ở đâu thì WPF vẽ bằng LoaiThuocView -->
        <DataTemplate DataType="{x:Type vm:LoaiThuocViewModel}">
            <views:LoaiThuocView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Margin="12">
            <Button Content="Loại thuốc" Padding="16,8"
                    Command="{Binding NavigateCommand}" CommandParameter="LoaiThuoc"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentViewModel}"/>
    </DockPanel>
</Window>
