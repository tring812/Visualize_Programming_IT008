<UserControl x:Class="PharmacyManagement.Views.NhaCungCapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nhà cung cấp" Style="{StaticResource PageTitle}"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" Margin="0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaNCC}" Width="Auto"/>
                <DataGridTextColumn Header="Tên nhà cung cấp" Binding="{Binding TenNCC}" Width="*"/>
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>
                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDienThoai}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Content="_Tên nhà cung cấp" Target="{Binding ElementName=txtTen}"/>
            <TextBox x:Name="txtTen" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding TenNCC, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="1" Content="_Địa chỉ" Target="{Binding ElementName=txtDiaChi}"/>
            <TextBox x:Name="txtDiaChi" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Content="_Số điện thoại" Target="{Binding ElementName=txtSoDienThoai}"/>
            <TextBox x:Name="txtSoDienThoai" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Thêm mới" Command="{Binding AddCommand}"/>
            <Button Content="Lưu" Command="{Binding SaveCommand}"/>
            <Button Content="Xóa" Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
