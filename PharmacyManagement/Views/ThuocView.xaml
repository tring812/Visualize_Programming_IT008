<UserControl x:Class="PharmacyManagement.Views.ThuocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Thuốc" Style="{StaticResource PageTitle}"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" Margin="0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaThuoc}" Width="Auto"/>
                <DataGridTextColumn Header="Tên thuốc" Binding="{Binding TenThuoc}" Width="*"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="Auto"/>
                <DataGridTextColumn Header="Giá (đồng)" Binding="{Binding GiaBan, StringFormat=N0}" Width="Auto"/>
                <DataGridTextColumn Header="Tồn kho" Binding="{Binding SoLuongTon}" Width="Auto"/>
                <DataGridTextColumn Header="Hạn dùng" Binding="{Binding HanSuDung, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                <DataGridTextColumn Header="Loại thuốc" Binding="{Binding TenLoai}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="_Tên thuốc" Target="{Binding ElementName=InputTenThuoc}"/>
            <TextBox x:Name="InputTenThuoc" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding TenThuoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="1" Content="_Đơn vị tính" Target="{Binding ElementName=InputDonViTinh}"/>
            <TextBox x:Name="InputDonViTinh" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding DonViTinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Content="_Giá bán (đồng)" Target="{Binding ElementName=InputGiaBan}"/>
            <TextBox x:Name="InputGiaBan" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding GiaBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="3" Content="_Số lượng tồn" Target="{Binding ElementName=InputSoLuongTon}"/>
            <TextBox x:Name="InputSoLuongTon" Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center"
                     Text="{Binding SoLuongTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="4" Content="_Loại thuốc" Target="{Binding ElementName=InputMaLoai}"/>
            <ComboBox x:Name="InputMaLoai" Grid.Row="4" Grid.Column="1"
                      ItemsSource="{Binding DanhSachLoai}" DisplayMemberPath="TenLoai" SelectedValuePath="MaLoai"
                      SelectedValue="{Binding MaLoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="5" Content="_Hạn dùng" Target="{Binding ElementName=InputHanSuDung}"/>
            <DatePicker x:Name="InputHanSuDung" Grid.Row="5" Grid.Column="1" Language="vi-VN"
                        SelectedDate="{Binding HanSuDung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Thêm mới" Command="{Binding AddCommand}"/>
            <Button Content="Lưu" Command="{Binding SaveCommand}"/>
            <Button Content="Xóa" Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
